        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við fundum engin virk tilboð á þínu svæði. Prófaðu að breyta staðsetningu eða athugaðu aftur síðar."
          }
        }
      }
    },
    "We couldn't find any restaurants matching your search, please try another search or check your spelling." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find any restaurants matching your search, please try another search or check your spelling."
