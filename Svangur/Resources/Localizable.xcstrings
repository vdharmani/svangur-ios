        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við höfum sent tengil á endurstillingu lykilorðs á\n%1$@. Vinsamlegast athugaðu\npóstinn þinn og fylgdu tenglinum til að endurstilla\nlykilorðið þitt."
          }
        }
      }
    },
